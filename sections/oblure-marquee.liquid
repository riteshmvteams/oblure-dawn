{% comment %}
  Oblure marquee

  A strip of text items that scrolls in a continuous loop (CSS only).
  When it directly follows an Oblure hero set to "Full screen", that hero is shortened
  by the strip's height so both fit on the first screen.

  Styles live in assets/oblure-marquee.css.
{% endcomment %}

{{ 'oblure-marquee.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign font_size_mobile = section.settings.font_size | times: 0.85 | round
  assign padding_mobile = section.settings.padding_block | times: 0.75 | round
  assign gap_mobile = section.settings.item_gap | times: 0.5 | round
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --oblure-marquee-font-size: {{ font_size_mobile }}px;
    --oblure-marquee-padding: {{ padding_mobile }}px;
    --oblure-marquee-gap: {{ gap_mobile }}px;
    --oblure-marquee-duration: {{ section.settings.duration }}s;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --oblure-marquee-font-size: {{ section.settings.font_size }}px;
      --oblure-marquee-padding: {{ section.settings.padding_block }}px;
      --oblure-marquee-gap: {{ section.settings.item_gap }}px;
    }
  }

  {%- if section.settings.fit_with_hero and section.blocks.size > 0 %}
    {% comment %}
      Shortens a full-screen Oblure hero placed directly above this section.
      Strip height = 2 × padding + font size × line height (1.3, see oblure-marquee.css).
    {% endcomment %}
    .oblure-hero-section:has(+ #shopify-section-{{ section.id }}) {
      --oblure-marquee-height: calc(2 * {{ padding_mobile }}px + {{ font_size_mobile }}px * 1.3);
    }

    @media screen and (min-width: 750px) {
      .oblure-hero-section:has(+ #shopify-section-{{ section.id }}) {
        --oblure-marquee-height: calc(2 * {{ section.settings.padding_block }}px + {{ section.settings.font_size }}px * 1.3);
      }
    }

    .oblure-hero-section:has(+ #shopify-section-{{ section.id }}) .oblure-hero--height-full {
      min-height: calc(100vh - var(--oblure-marquee-height));
      min-height: calc(100svh - var(--oblure-marquee-height));
    }

    {% comment %} Sits flush under the hero even if Theme settings add space between sections. {% endcomment %}
    .oblure-hero-section + #shopify-section-{{ section.id }} {
      margin-top: 0;
    }
  {%- endif %}
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="oblure-marquee color-{{ section.settings.color_scheme }} gradient oblure-marquee--{{ section.settings.direction }}{% if section.settings.pause_on_hover %} oblure-marquee--pause-on-hover{% endif %}{% if section.settings.uppercase %} oblure-marquee--uppercase{% endif %}"
  >
    {%- comment -%}
      Two identical groups move side by side so the loop is seamless.
      The copy is hidden from assistive technology and removed from the tab order.
    {%- endcomment -%}
    {%- for copy in (1..2) -%}
      <ul
        class="oblure-marquee__group list-unstyled"
        role="list"
        {% unless forloop.first %}
          aria-hidden="true"
        {% endunless %}
      >
        {%- for block in section.blocks -%}
          <li
            class="oblure-marquee__item"
            {% if forloop.parentloop.first %}
              {{ block.shopify_attributes }}
            {% endif %}
          >
            {%- if block.settings.link != blank -%}
              <a
                class="oblure-marquee__text oblure-marquee__text--link"
                href="{{ block.settings.link }}"
                {% unless forloop.parentloop.first %}
                  tabindex="-1"
                {% endunless %}
              >
                {{- block.settings.text | escape -}}
              </a>
            {%- else -%}
              <span class="oblure-marquee__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Oblure scrolling text",
  "tag": "section",
  "class": "section oblure-marquee-section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 17
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase text",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Top and bottom padding",
      "default": 18
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Space between items",
      "default": 80
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "duration",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Time for one loop",
      "info": "Higher is slower.",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "info": "It always pauses while a link has keyboard focus, and stays still for visitors who turn off motion.",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "fit_with_hero",
      "label": "Fit with the hero on the first screen",
      "info": "When placed directly below an Oblure hero set to \"Full screen\", the hero gets shorter so both are visible.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Discover the collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Oblure scrolling text",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
