  "name": "side by side image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
    {
      "type": "url",
      "id": "left_url",
      "label": "Link on left image"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left heading"
    },
    {
      "type": "url",
      "id": "right_url",
      "label": "Link on right image"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Right heading"
    }
  ],
  "presets": [
    {
      "name": "Side by side image"
    }
  ]
}
{% endschema %}
