{% comment %} Oblure: `.is-visible` is added by assets/oblure-animations.js (data-oblure-reveal = visible share that triggers it). {% endcomment %}
{% comment %} Oblure: images are responsive (image_tag with widths/sizes, lazy) instead of the original uploads, which were up to 18 MB each and made scrolling stutter. {% endcomment %}
<div class="side-by-side-image side-by-side-bg page-width" data-oblure-reveal="0.15">
    <div class="whole-content">
      <div class="left-content">
          <div class="heading">
              <h2>{{ section.settings.left_heading }}</h2>
          </div>
          <div class="image-container">
              <a href=" {{ section.settings.left_url }}">
                {%- liquid
  assign oblure_image = section.settings.left_image
  assign oblure_alt = oblure_image.alt | default: section.settings.left_heading | escape
-%}
{%- if oblure_image != blank -%}
  {{
    oblure_image
    | image_url: width: 2000
    | image_tag:
      widths: '550, 750, 1100, 1500, 2000',
      sizes: '(min-width: 750px) 50vw, 100vw',
      loading: 'lazy',
      decoding: 'async',
      alt: oblure_alt
  }}
{%- endif -%}
              </a>
          </div>
      </div>  

      <div class="right-content">
          <div class="heading">
            <h2> {{ section.settings.right_heading }}</h2>
          </div>
          <div class="image-container">
            <a href="{{ section.settings.right_url }}">
              {%- liquid
  assign oblure_image = section.settings.right_image
  assign oblure_alt = oblure_image.alt | default: section.settings.right_heading | escape
-%}
{%- if oblure_image != blank -%}
  {{
    oblure_image
    | image_url: width: 2000
    | image_tag:
      widths: '550, 750, 1100, 1500, 2000',
      sizes: '(min-width: 750px) 50vw, 100vw',
      loading: 'lazy',
      decoding: 'async',
      alt: oblure_alt
  }}
{%- endif -%}
            </a>
          </div>
      </div>   
    </div>
</div>




{% comment %} --------------animation test css----------------- {% endcomment %}

<style>
  .side-by-side-bg .left-content,
  .side-by-side-bg .right-content {
    overflow: hidden;
  }

  .side-by-side-bg .left-content .image-container {
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
  }

  .side-by-side-bg .right-content .image-container {
    overflow: hidden;
    clip-path: inset(0 0 0 100%);
  }

  .side-by-side-bg .image-container img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    transition: transform 1.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .side-by-side-bg.is-visible .left-content .image-container,
  .side-by-side-bg.is-visible .right-content .image-container {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .side-by-side-bg.is-visible .image-container img {
    transform: scale(1);
  }

  .side-by-side-bg .heading {
    opacity: 0;
    transform: translateY(25px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .side-by-side-bg.is-visible .heading {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (max-width: 749px) {
    .side-by-side-bg .left-content .image-container,
    .side-by-side-bg .right-content .image-container {
      clip-path: inset(0 0 100% 0);
    }

    .side-by-side-bg.is-visible .left-content .image-container,
    .side-by-side-bg.is-visible .right-content .image-container {
      clip-path: inset(0 0 0 0);
    }
  }
</style>



