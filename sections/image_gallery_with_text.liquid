      "label": "Left image link"
    },
	 {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center image"
    },
	 {
      "type": "url",
      "id": "center_image_url",
      "label": "Center image link"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
	 {
      "type": "url",
      "id": "right_image_url",
      "label": "Right image link"
    },
	 {
      "type": "text",
      "id": "center_heading",
      "label": "Center Heading"
    },
	 {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
	 {
      "type": "url",
      "id": "btn_url",
      "label": "Button link"
    },
	 {
      "type": "text",
      "id": "btn_text",
      "label": "Button text"
    }
  ],
  "presets": [
