 <style>
  .image-gallery{
    --ig-ink:#161412;               /* colour of the button fill */
    --ig-ease:cubic-bezier(.77,0,.18,1);
    --ig-out:cubic-bezier(.2,.9,.2,1);
  }

  /* ---------- HEADING: letters flip in ---------- */
  .image-gallery[data-anim] .heading h2{ overflow:hidden; perspective:700px; padding-bottom:.12em; }
  .oa-word{ display:inline-block; white-space:nowrap; }
  .oa-char{ display:inline-block; opacity:0; transform:translateY(115%) rotateX(-90deg); transform-origin:50% 100%; }
  .image-gallery.is-visible .oa-char{
    animation:ig-drop .9s cubic-bezier(.2,1.4,.4,1) forwards;
    animation-delay:calc(var(--i) * 70ms);
  }
  @keyframes ig-drop{ to{ opacity:1; transform:none; } }

  /* ---------- IMAGES: curtain wipe from 3 directions ---------- */
  .image-gallery[data-anim] .image-wapper{ position:relative; overflow:hidden; clip-path:inset(0 0 100% 0); }
  .image-gallery[data-anim] .left-content   .image-wapper{ clip-path:inset(100% 0 0 0); --d:.2s; }
  .image-gallery[data-anim] .center-content .image-wapper{ clip-path:inset(0 0 100% 0); --d:.5s; }
  .image-gallery[data-anim] .right-content  .image-wapper{ clip-path:inset(0 0 0 100%); --d:.8s; }
  .image-gallery.is-visible .image-wapper{ animation:ig-wipe 1.5s var(--ig-ease) var(--d,0s) forwards; }
  @keyframes ig-wipe{ to{ clip-path:inset(0 0 0 0); } }

  /* image starts zoomed + tilted, settles slightly oversized (room for parallax) */
  .image-gallery[data-anim] .image-wapper img{
    width:100%; height:100%; object-fit:cover;
    scale:1.9; rotate:-6deg;
    translate:0 var(--py,0px);                       /* set by JS on scroll */
    transition:scale 2.2s var(--ig-out), rotate 2.2s var(--ig-out);
  }
  .image-gallery[data-anim].is-visible .image-wapper img{
    scale:1.12; rotate:0deg; transition-delay:var(--d,0s);
  }

  /* light sweep across each image */
  .image-gallery[data-anim] .image-wapper::after{
    content:""; position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.55) 50%,transparent 65%);
    transform:translateX(-130%);
  }
  .image-gallery.is-visible .image-wapper::after{ animation:ig-shine 1.4s ease-out calc(var(--d,0s) + 1.1s) 1 both; }
  @keyframes ig-shine{ to{ transform:translateX(130%); } }

  /* ---------- CENTER CARD: wipe in, text rises, button pops ---------- */
  .image-gallery[data-anim] .text-container{ clip-path:inset(0 100% 0 0); }
  .image-gallery.is-visible .text-container{ animation:ig-card 1.3s var(--ig-ease) 1.1s forwards; }
  @keyframes ig-card{ to{ clip-path:inset(0 0 0 0); } }

  .oa-mask{ display:block; overflow:hidden; }
  .oa-mask > span{ display:block; transform:translateY(110%) skewY(6deg); transform-origin:left bottom; }
  .image-gallery.is-visible .oa-mask > span{
    animation:ig-rise .9s var(--ig-out) forwards;
    animation-delay:calc(1.7s + var(--i,0) * .14s);
  }
  @keyframes ig-rise{ to{ transform:none; } }

  .image-gallery[data-anim] .text-container a{
    display:inline-block;
    background-image:linear-gradient(var(--ig-ink),var(--ig-ink));
    background-repeat:no-repeat; background-position:center bottom; background-size:100% 0%;
    transition:background-size .45s var(--ig-ease), color .35s, letter-spacing .35s;
  }
  .image-gallery.is-visible .text-container a{ animation:ig-pop .8s cubic-bezier(.2,1.6,.4,1) 2.4s backwards; }
  @keyframes ig-pop{ from{ transform:scale(0) rotate(-20deg); opacity:0; } }
  .image-gallery[data-anim] .text-container a:hover{ background-size:100% 100%; color:#F1E2A3; letter-spacing:.04em; }

  /* ---------- HOVER: 3D tilt + dim the other columns ---------- */
  .image-gallery[data-anim] .static-content{
    transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
    transition:transform .25s ease-out, opacity .5s, filter .5s;
  }
  @media (hover:hover){
    .image-gallery[data-anim].is-visible .inner-content:hover .static-content{ opacity:.55; filter:blur(2px) saturate(.7); }
    .image-gallery[data-anim].is-visible .inner-content .static-content:hover{ opacity:1; filter:none; }
    .image-gallery[data-anim].is-visible .static-content:hover .image-wapper img{
      scale:1.24; rotate:1deg; transition-delay:0s; transition-duration:1.2s;
    }
  }
</style>







