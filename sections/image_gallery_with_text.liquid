 {% comment %} <script>
  document.addEventListener('DOMContentLoaded', function () {
    const sections = document.querySelectorAll('.image-gallery');

    const observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15
    });

    sections.forEach(function (section) {
      observer.observe(section);
    });
  });
</script>  {% endcomment %}



<script>
(function () {
  if (window.__igAnim) { window.__igAnim.initAll(); return; }

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine   = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var list = [], ticking = false;

  function splitHeading(h2) {
    var text = h2.textContent.trim(), i = 0;
    h2.setAttribute('aria-label', text);
    h2.textContent = '';
    text.split(/\s+/).forEach(function (word, w, arr) {
      var wrap = document.createElement('span');
      wrap.className = 'oa-word';
      wrap.setAttribute('aria-hidden', 'true');
      word.split('').forEach(function (ch) {
        var s = document.createElement('span');
        s.className = 'oa-char';
        s.textContent = ch;
        s.style.setProperty('--i', i++);
        wrap.appendChild(s);
      });
      h2.appendChild(wrap);
      if (w < arr.length - 1) h2.appendChild(document.createTextNode(' '));
    });
  }

  function maskText(el, index) {
    if (!el || !el.textContent.trim()) return;
    var outer = document.createElement('span'), inner = document.createElement('span');
    outer.className = 'oa-mask';
    outer.style.setProperty('--i', index);
    while (el.firstChild) inner.appendChild(el.firstChild);
    outer.appendChild(inner);
    el.appendChild(outer);
  }

  /* parallax: left image drifts one way, right the other */
  function update() {
    ticking = false;
    list = list.filter(function (g) { return g.sec.isConnected; });
    list.forEach(function (g) {
      var r = g.sec.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      var p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
      p = Math.max(-1, Math.min(1, p));
      if (g.left)   g.left.style.setProperty('--py',   (p * 36)  + 'px');
      if (g.center) g.center.style.setProperty('--py', (p * -18) + 'px');
      if (g.right)  g.right.style.setProperty('--py',  (p * -36) + 'px');
    });
  }
  function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }

  function init(sec) {
    if (sec.__igInit) return;
    sec.__igInit = true;

    if (reduce || !('IntersectionObserver' in window)) {
      sec.classList.add('is-visible');
      return;
    }

    var h2 = sec.querySelector('.heading h2');
    if (h2 && h2.textContent.trim()) splitHeading(h2);
    maskText(sec.querySelector('.text-container h3'), 0);
    maskText(sec.querySelector('.text-container p'), 1);
    sec.setAttribute('data-anim', 'ready');

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { sec.classList.add('is-visible'); io.unobserve(sec); }
      });
    }, { threshold: 0.2 });
    io.observe(sec);

    list.push({
      sec: sec,
      left:   sec.querySelector('.left-content img'),
      center: sec.querySelector('.center-content .image-wapper img'),
      right:  sec.querySelector('.right-content img')
    });

    if (fine) {
      sec.querySelectorAll('.static-content').forEach(function (card) {
        card.addEventListener('mousemove', function (e) {
          var b = card.getBoundingClientRect();
          var x = (e.clientX - b.left) / b.width - 0.5;
          var y = (e.clientY - b.top) / b.height - 0.5;
          card.style.setProperty('--ry', (x * 10) + 'deg');
          card.style.setProperty('--rx', (-y * 10) + 'deg');
        });
        card.addEventListener('mouseleave', function () {
          card.style.setProperty('--ry', '0deg');
          card.style.setProperty('--rx', '0deg');
        });
      });
    }
    update();
  }

  function initAll(root) {
    (root || document).querySelectorAll('.image-gallery').forEach(init);
  }

  window.__igAnim = { initAll: initAll };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  document.addEventListener('DOMContentLoaded', function () { initAll(); });
  document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
  initAll();
})();
</script>