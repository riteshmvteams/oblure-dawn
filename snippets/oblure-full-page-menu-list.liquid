{% doc %}
  Renders one menu of the full page menu (see snippets/oblure-full-page-menu.liquid).

  Top-level links with children become accordion toggles; their children (and any
  grandchildren, listed under each child) are revealed below them.
  Every item carries the hover background of the page/collection/product/blog/article
  it links to, read from its `custom.page_color_theme` metaobject
  (`menu_hover_background`, falling back to `page_background`).

  @param {object} menu - The link list to render.
  @param {string} variant - 'primary' or 'secondary'; sets the text style.
  @param {string} id_prefix - Unique prefix for the accordion panel ids.

  @example
  {% render 'oblure-full-page-menu-list', menu: primary_menu, variant: 'primary', id_prefix: 'OblureFpmPrimary' %}
{% enddoc %}

<ul class="oblure-fpm__list oblure-fpm__list--{{ variant }} list-unstyled" role="list">
  {%- for link in menu.links -%}
    {%- liquid
      assign color_theme = link.object.metafields.custom.page_color_theme.value
      assign hover_background = color_theme.menu_hover_background.value | default: color_theme.page_background.value
      assign sublist_id = id_prefix | append: '-' | append: forloop.index
    -%}
    <li
      class="oblure-fpm__item"
      {% if hover_background != blank %}
        data-hover-background="{{ hover_background }}"
      {% endif %}
    >
      {%- if link.links != blank -%}
        <button
          type="button"
          class="oblure-fpm__link oblure-fpm__link--toggle{% if link.child_active %} oblure-fpm__link--active{% endif %}"
          aria-expanded="false"
          aria-controls="{{ sublist_id }}"
          data-oblure-fpm-accordion
        >
          {{- link.title | escape -}}
          <span class="oblure-fpm__toggle-icon" aria-hidden="true"></span>
        </button>

        <ul id="{{ sublist_id }}" class="oblure-fpm__sublist list-unstyled" role="list" hidden>
          {%- for child in link.links -%}
            {%- liquid
              assign child_theme = child.object.metafields.custom.page_color_theme.value
              assign child_background = child_theme.menu_hover_background.value | default: child_theme.page_background.value
            -%}
            <li
              class="oblure-fpm__item"
              {% if child_background != blank %}
                data-hover-background="{{ child_background }}"
              {% endif %}
            >
              <a
                href="{{ child.url }}"
                class="oblure-fpm__link oblure-fpm__link--child{% if child.current %} oblure-fpm__link--active{% endif %}"
                {% if child.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- child.title | escape -}}
              </a>

              {%- if child.links != blank -%}
                <ul class="oblure-fpm__sublist oblure-fpm__sublist--nested list-unstyled" role="list">
                  {%- for grandchild in child.links -%}
                    {%- liquid
                      assign grandchild_theme = grandchild.object.metafields.custom.page_color_theme.value
                      assign grandchild_background = grandchild_theme.menu_hover_background.value | default: grandchild_theme.page_background.value
                    -%}
                    <li
                      class="oblure-fpm__item"
                      {% if grandchild_background != blank %}
                        data-hover-background="{{ grandchild_background }}"
                      {% endif %}
                    >
                      <a
                        href="{{ grandchild.url }}"
                        class="oblure-fpm__link oblure-fpm__link--child{% if grandchild.current %} oblure-fpm__link--active{% endif %}"
                        {% if grandchild.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- grandchild.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <a
          href="{{ link.url }}"
          class="oblure-fpm__link{% if link.current %} oblure-fpm__link--active{% endif %}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
