{% doc %}
  Applies the current page's color theme: `page_background` to the header and footer,
  `light_page_background` to the page body (between header and footer).

  The theme is a `page_color_theme` metaobject, taken from:
  1. the `custom.page_color_theme` metafield of the page, collection, product, blog or
     article being viewed (articles without one fall back to their blog), otherwise
  2. the Theme settings > "Page color themes" entry for pages that have no metafield:
     home, search, all products (/collections/all), collections list, cart and 404.

  Exposes both colors on :root for other components:
  - `--oblure-page-background`: full page menu default background, Oblure collection banner.
  - `--oblure-page-background-light`: Oblure product grid and Oblure rich text backgrounds
    (sections with their own color scheme otherwise keep it).

  @example
  {% render 'oblure-page-color-theme' %}
{% enddoc %}

{%- liquid
  case request.page_type
    when 'page'
      assign color_resource = page
    when 'collection'
      assign color_resource = collection
    when 'product'
      assign color_resource = product
    when 'blog'
      assign color_resource = blog
    when 'article'
      assign color_resource = article
      if article.metafields.custom.page_color_theme == blank
        assign color_resource = blog
      endif
  endcase

  assign color_theme = color_resource.metafields.custom.page_color_theme.value

  if color_theme == blank
    case request.page_type
      when 'index'
        assign color_theme = settings.oblure_page_theme_home
      when 'search'
        assign color_theme = settings.oblure_page_theme_search
      when 'collection'
        if collection.handle == 'all'
          assign color_theme = settings.oblure_page_theme_all_products
        endif
      when 'list-collections'
        assign color_theme = settings.oblure_page_theme_collections
      when 'cart'
        assign color_theme = settings.oblure_page_theme_cart
      when '404'
        assign color_theme = settings.oblure_page_theme_404
    endcase
  endif

  assign page_background = color_theme.page_background.value
  assign light_page_background = color_theme.light_page_background.value
-%}

{%- if page_background != blank or light_page_background != blank -%}
  {%- style -%}
    {%- if page_background != blank %}
      :root {
        --oblure-page-background: {{ page_background }};
      }

      .section-header .header-wrapper,
      .shopify-section-group-footer-group .footer {
        background: var(--oblure-page-background);
      }
    {%- endif %}

    {%- if light_page_background != blank %}
      :root {
        --oblure-page-background-light: {{ light_page_background }};
      }

      {% comment %} body.gradient: beats Dawn's `.gradient` / color scheme background on <body>. {% endcomment %}
      body.gradient {
        background: var(--oblure-page-background-light);
      }
    {%- endif %}
  {%- endstyle -%}
{%- endif -%}