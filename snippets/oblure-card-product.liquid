{% doc %}
  Oblure product card, used by sections/oblure-collection-product-grid.liquid.
  Based on Dawn's snippets/card-product.liquid (left unchanged), redesigned for Oblure:
  image with an optional NEW badge, title and price on the left, color swatches on the right.
  Styles: assets/oblure-product-grid.css.

  @param {object} card_product - The product to render.
  @param {boolean} [lazy_load] - Lazy load the image. Default: true.
  @param {string} [image_sizes] - The image `sizes` attribute. Default: '(min-width: 750px) 50vw, 100vw'.
  @param {string} [new_tag] - Products with this tag get the NEW badge (compared case-insensitively).
  @param {string} [new_label] - Text of the NEW badge.
  @param {string} [swatch_option_names] - Comma-separated option names that hold colors, e.g. 'Color, Colour, Färg'.
  @param {number} [max_swatches] - How many swatches to show before "+N". Default: 6.
  @param {boolean} [show_secondary_image] - On hover, switch to the product's second image ("light off").
  @param {string} [hover_effect] - 'fade' or 'flicker'; how the second image comes in. Default: 'fade'.
  @param {boolean} [enable_video] - Play Shopify-hosted videos: a first-media video plays (muted, looping)
    while the card is on screen, a second-media video plays on hover. Needs assets/oblure-card-media.js.
    Off, or for YouTube/Vimeo, the video's preview image is shown instead.
  @param {string} [product_view_context] - Context for the standard "view" event.

  @example
  {% render 'oblure-card-product', card_product: product, new_tag: 'new', new_label: 'New' %}
{% enddoc %}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign max_swatches = max_swatches | default: 6
    assign image_sizes = image_sizes | default: '(min-width: 750px) 50vw, 100vw'
    assign hover_effect = hover_effect | default: 'fade'

    assign secondary_media = null
    if show_secondary_image and card_product.media.size > 1
      assign secondary_media = card_product.media[1]
    endif

    # Only Shopify-hosted videos can play here; other media types show their preview image.
    assign primary_is_video = false
    assign secondary_is_video = false
    if enable_video
      if card_product.featured_media.media_type == 'video'
        assign primary_is_video = true
      endif
      if secondary_media.media_type == 'video'
        assign secondary_is_video = true
      endif
    endif

    assign media_tag = 'div'
    if primary_is_video or secondary_is_video
      assign media_tag = 'oblure-card-media'
    endif

    # NEW badge: tag match, ignoring case and spacing.
    assign is_new = false
    assign new_tag_handle = new_tag | handle
    if new_tag_handle != blank
      for tag in card_product.tags
        assign tag_handle = tag | handle
        if tag_handle == new_tag_handle
          assign is_new = true
          break
        endif
      endfor
    endif

    # Color option: the first option whose name is in swatch_option_names.
    assign color_option = null
    assign swatch_names = swatch_option_names | downcase | split: ','
    for option in card_product.options_with_values
      assign option_name = option.name | downcase | strip
      for swatch_name in swatch_names
        assign swatch_name_clean = swatch_name | strip
        if option_name == swatch_name_clean
          assign color_option = option
          break
        endif
      endfor
      if color_option
        break
      endif
    endfor

    # Price, formatted like Dawn's snippets/price.liquid.
    assign on_sale = false
    if card_product.compare_at_price > card_product.price
      assign on_sale = true
    endif

    if settings.currency_code_enabled
      assign money_price = card_product.price | money_with_currency
      assign money_compare = card_product.compare_at_price | money_with_currency
    else
      assign money_price = card_product.price | money
      assign money_compare = card_product.compare_at_price | money
    endif

    if card_product.price_varies
      assign money_price = 'products.product.price.from_price_html' | t: price: money_price
    endif
  -%}

  <product-component view-event-payload="{{ card_product | standard_event_data: 'view', context: product_view_context | escape }}">
    <article class="oblure-card{% if secondary_media %} oblure-card--has-secondary oblure-card--effect-{{ hover_effect }}{% endif %}{% unless card_product.available %} oblure-card--sold-out{% endunless %}">
      <{{ media_tag }} class="oblure-card__media">
        {%- if card_product.featured_media -%}
          {%- liquid
            assign image_loading = 'lazy'
            if lazy_load == false
              assign image_loading = 'eager'
            endif
          -%}
          {%- if primary_is_video -%}
            {%- render 'oblure-card-video',
              media: card_product.featured_media,
              class: 'oblure-card__image oblure-card__image--primary',
              playback: 'visible'
            -%}
          {%- else -%}
            {{
              card_product.featured_media
              | image_url: width: 2400
              | image_tag:
                class: 'oblure-card__image oblure-card__image--primary',
                widths: '360, 533, 720, 940, 1066, 1400, 1800, 2400',
                sizes: image_sizes,
                loading: image_loading,
                alt: card_product.featured_media.alt
            }}
          {%- endif -%}

          {%- if secondary_is_video -%}
            {%- render 'oblure-card-video',
              media: secondary_media,
              class: 'oblure-card__image oblure-card__image--secondary',
              playback: 'hover'
            -%}
          {%- elsif secondary_media -%}
            {% comment %} "Light off" image, revealed on hover; decorative (empty alt), so screen readers skip it. {% endcomment %}
            {{
              secondary_media
              | image_url: width: 2400
              | image_tag:
                class: 'oblure-card__image oblure-card__image--secondary',
                widths: '360, 533, 720, 940, 1066, 1400, 1800, 2400',
                sizes: image_sizes,
                loading: 'lazy',
                alt: ''
            }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'oblure-card__image oblure-card__image--placeholder' }}
        {%- endif -%}

        {%- if is_new and new_label != blank -%}
          <span class="oblure-card__badge">{{ new_label | escape }}</span>
        {%- endif -%}
      </{{ media_tag }}>

      <div class="oblure-card__info">
        <div class="oblure-card__text">
          <h3 class="oblure-card__title">
            {% comment %} Stretched over the whole card, see .oblure-card__link::after. {% endcomment %}
            <a href="{{ card_product.url }}" class="oblure-card__link">
              {{- card_product.title | escape -}}
            </a>
          </h3>

          <div class="oblure-card__price">
            {%- if on_sale -%}
              <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
              <span class="oblure-card__price-current oblure-card__price-current--sale">{{ money_price }}</span>
              <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
              <s class="oblure-card__price-compare">{{ money_compare }}</s>
            {%- else -%}
              <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
              <span class="oblure-card__price-current">{{ money_price }}</span>
            {%- endif -%}

            {%- unless card_product.available -%}
              <span class="oblure-card__sold-out">{{ 'products.product.sold_out' | t }}</span>
            {%- endunless -%}
          </div>
        </div>

        {%- if color_option and color_option.values.size > 0 -%}
          <ul class="oblure-card__swatches list-unstyled" role="list" aria-label="{{ color_option.name | escape }}">
            {%- for value in color_option.values limit: max_swatches -%}
              {%- liquid
                assign swatch_background = null
                if value.swatch.image
                  assign swatch_image_url = value.swatch.image | image_url: width: 40
                  assign swatch_background = 'url(' | append: swatch_image_url | append: ') center / cover'
                elsif value.swatch.color
                  assign swatch_background = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                endif
              -%}
              <li
                class="oblure-card__swatch{% unless swatch_background %} oblure-card__swatch--empty{% endunless %}"
                title="{{ value | escape }}"
                {% if swatch_background %}
                  style="--oblure-swatch: {{ swatch_background }};"
                {% endif %}
              >
                <span class="visually-hidden">{{ value | escape }}</span>
              </li>
            {%- endfor -%}

            {%- if color_option.values.size > max_swatches -%}
              <li class="oblure-card__swatch-more">+{{ color_option.values.size | minus: max_swatches }}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </article>
  </product-component>
{%- endif -%}